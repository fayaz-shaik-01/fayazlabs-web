# FayazLabs Web — Environment Variables
# Copy this to .env.local and fill in values

# ── Backend Platform API ─────────────────────────────────────────────
# Server-side: used by Next.js API routes to proxy to the Java backend
PLATFORM_URL=http://localhost:8080

# Client-side: used by browser fetch calls (must be NEXT_PUBLIC_ prefixed)
NEXT_PUBLIC_PLATFORM_URL=http://localhost:8080

# ── Authentication ───────────────────────────────────────────────────
# Google OAuth Client ID (for Google Sign-In button)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Analytics (optional) ─────────────────────────────────────────────
# Vercel Analytics — auto-detected on Vercel, no config needed
# NEXT_PUBLIC_ANALYTICS_ID=

# ── Site Metadata ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
